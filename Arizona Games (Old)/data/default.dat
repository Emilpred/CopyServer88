#
# Load IDEs first, then the models and after that the IPLs
#

# everything is loaded on a per directory basis and in alphabetical order
# to improve the speed of loading
IMG SAMP\CUSTOM.IMG
IMG SAMP\SAMP.IMG
IMG MODELS\VEHS.IMG
IMG MODELS\VEHS_2.IMG
IMG MODELS\VEHS_3.IMG
IMG MODELS\VEHS_4.IMG
IMG MODELS\VEHS_5.IMG
IMG MODELS\VEHS_6.IMG
IMG MODELS\VEHS_7.IMG
IMG MODELS\PEDS.IMG
IMG MODELS\PEDS_2.IMG
IMG MODELS\vc.IMG
IMG MODELS\GTA3.IMG
IMG MODELS\GTA_INT.IMG
IMG MODELS\ACCESSORIES.IMG
IMG MODELS\GAMEMODS.IMG
IMG MODELS\PUBG.IMG
IMG MODELS\MAP_OBJECT.IMG
IMG MODELS\TUNING.IMG
IMG MODELS\custom_int.IMG
IMG MODELS\WEAPONS.IMG

#
# Object types
#
IDE DATA\DEFAULT.IDE
IDE DATA\VEHICLES.IDE
IDE DATA\PEDS.IDE

#
# Standard objects
#
# texture dictionaries
#TEXDICTION MODELS\GENERIC\WHEELS.TXD
#TEXDICTION MODELS\GENERIC.TXD

# model data
#MODELFILE MODELS\GENERIC\AIR_VLO.DFF
#MODELFILE MODELS\GENERIC\WHEELS.DFF
#

# custom weapons
IDE DATA\WEAPONS.IDE

#collision data
#COLFILE 0 MODELS\COLL\VEHICLES.COL
COLFILE 0 MODELS\COLL\WEAPONS.COL